# Required: Name of the SMB share (mounted at /mnt/<SMB_SHARE>)
# Example: SMB_SHARE=nas-backups
SMB_SHARE=

# Optional: Override defaults

# Source directory for Proxmox backups
# SRC_DIR=/var/lib/vz/dump

# Subdirectory under SMB mount for backups
# BACKUP_SUBDIR=proxmox-backups

# Dashboard web server port
# WEB_PORT=8080

# Directory for dashboard web files
# WEB_DIR=/var/www/backup-status

# Directory for log files
# LOG_DIR=/var/log

# Directory where script and index.html are deployed
# SCRIPT_DIR=~/move-backups

# Seconds to keep dashboard available after completion
# DASHBOARD_TIMEOUT=60

# Seconds to keep dashboard available after dry-run completion
# DRY_RUN_TIMEOUT=30

# Advanced/Testing: Override full destination path
# Note: If set, SMB_SHARE validation is skipped
# DST_DIR=/mnt/nas-backups/proxmox-backups
